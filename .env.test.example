# Automated tests mock discovery/token endpoints and never use the hosted client.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vinventory_test
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5174
COOKIE_SECRET=replace-with-an-isolated-test-secret-32chars
SESSION_TTL_HOURS=1
VAUTH_ISSUER=http://localhost:3002/api/auth
VAUTH_CLIENT_ID=vinventory-test
VAUTH_CLIENT_SECRET=replace-with-test-vauth-client-secret
VAUTH_REDIRECT_URI=http://localhost:5174/api/auth/oauth2/callback/voss
