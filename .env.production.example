NODE_ENV=production
DATABASE_URL=postgresql://user:password@neon-host/vinventory?sslmode=require
API_HOST=0.0.0.0
API_PORT=3000
WEB_ORIGIN=https://vinventory.vosslabs.org
COOKIE_SECRET=replace-with-a-production-secret-from-secret-storage
SESSION_TTL_HOURS=12
VOSS_DISCOVERY_URL=https://accounts.vosslabs.org/api/auth/.well-known/openid-configuration
VOSS_CLIENT_ID=replace-with-registered-vinventory-client-id
VOSS_CLIENT_SECRET=replace-with-registered-vinventory-client-secret
VAUTH_REDIRECT_URI=https://vinventory.vosslabs.org/api/auth/oauth2/callback/voss
