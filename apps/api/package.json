{
  "name": "@vinventory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import ../../scripts/load-env.mjs --import tsx --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ../../scripts/load-env.mjs dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@vinventory/contracts": "workspace:*",
    "@vinventory/db": "workspace:*",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fastify": "5.12.5",
    "openid-client": "6.8.8",
    "yauzl": "^3.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "catalog:",
    "@types/yauzl": "^3.4.0",
    "drizzle-orm": "0.45.4",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
